{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @marketplace/backend build"
  },
  "deploy": {
    "preDeployCommand": "pnpm db:migrate && node apps/backend/dist/operations/bind-identities-main.js",
    "startCommand": "pnpm --filter @marketplace/backend start:api",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
