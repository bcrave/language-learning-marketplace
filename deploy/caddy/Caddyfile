# Caddy is the deployment's only public application origin (ADR-0028). It owns
# two halves of that role.
#
# The source-address half: it discards attacker-supplied forwarding headers and
# passes the address it verified over Railway private networking, so the API can
# key ADR-0025's per-source request limits on the person making the request
# rather than on Caddy.
#
# The browser half: it writes the deterministic global browser policy the public
# portfolio threat model defines, overwriting whatever a handler produced. The
# policy denies everything by default and names exact provider origins; the two
# `{$...}` substitutions come from validated public deployment configuration and
# never from a request header. An unset one narrows the policy — the provider
# simply becomes unreachable — rather than widening it to a wildcard.
# `apps/backend/src/operations/browser-policy.ts` is the single statement of
# this policy, asserted against this file and against the deployed response.
# The threat model runs the complete policy in report-only mode against the
# private deployment first and then enforces the identical policy, which is why
# only the header's name is switchable and the policy itself is not.
#
# Environment values, none of which are stored here:
#   PUBLIC_DOMAIN             the sole public hostname
#   API_PRIVATE_ORIGIN        the API's Railway private address, e.g. api.railway.internal:4000
#   API_TRUSTED_PROXY_SECRET  shared with the API as API_TRUSTED_PROXY_SECRET
#   AUTH0_TENANT_ORIGIN       the Auth0 tenant origin the SPA connects to
#   SENTRY_INGEST_ORIGIN      the exact Sentry ingestion origin, with no tunnel here
#   CSP_HEADER_NAME           Content-Security-Policy-Report-Only for the private
#                             rollout; unset enforces the identical policy. Set
#                             to an empty value it names no header at all, and
#                             Caddy accepts that silently — the release's
#                             public-surface check is what refuses a deployment
#                             serving no policy.
#   WEB_ROOT                  directory holding the built Vite assets
{
	# Nothing sits in front of Caddy, so no proxy is trusted and {client_ip}
	# always resolves to the peer that actually connected.
	servers {
		trusted_proxies static
	}
}

{$PUBLIC_DOMAIN} {
	# Discard inbound forwarding context before any handler can read it,
	# including the two headers Caddy itself uses to speak to the API. A
	# caller cannot mint a fresh rate-limit bucket with a header it chooses.
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Proto
	request_header -Forwarded
	request_header -X-Real-IP
	request_header -X-Verified-Source
	request_header -X-Proxy-Authorization

	header {
		{$CSP_HEADER_NAME:Content-Security-Policy} "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self'; connect-src 'self' {$AUTH0_TENANT_ORIGIN} {$SENTRY_INGEST_ORIGIN}; manifest-src 'self'; worker-src 'self'; frame-src 'none'; media-src 'none'; upgrade-insecure-requests"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"

		# Authenticated GraphQL and the SPA entry document are never stored.
		# Content-hashed assets override this below, where the name already
		# changes whenever the bytes do.
		Cache-Control "no-store"

		# Nothing needs to know which server or version answered.
		-Server
		-X-Powered-By
	}

	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	handle /graphql {
		reverse_proxy {$API_PRIVATE_ORIGIN} {
			# Exactly one verified address, never a chain: the API fails
			# closed on anything else.
			header_up X-Verified-Source {client_ip}
			header_up X-Proxy-Authorization {$API_TRUSTED_PROXY_SECRET}
			header_up -X-Forwarded-For
		}
	}

	handle {
		root * {$WEB_ROOT}
		try_files {path} /index.html
		file_server
	}
}
