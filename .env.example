DATABASE_URL=postgres://marketplace:marketplace@localhost:5433/marketplace
AUTH_MODE=fake
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
API_PORT=4000
API_SOURCE_REQUEST_LIMIT=120
# Set only where Caddy fronts the API, and to the same value Caddy sends.
# Local development connects directly, so the API keys on the connection.
# API_TRUSTED_PROXY_SECRET=
# ADR 0028's sole public origin, as a browser names it. The API refuses any
# `/graphql` request that does not carry it in `Origin`, so it is required in
# production. Local development connects directly and sets nothing.
# PUBLIC_ORIGIN=https://demonstration.example.test

VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=public-client-id
VITE_AUTH0_AUDIENCE=https://api.example.test

# Names the build a process is running. Railway sets it per service from the
# released commit; the worker heartbeat and its release gate compare on it.
APP_RELEASE=development

# Where the release gate reaches the API's internal health probes, over Railway
# private networking. The API has no public address, so this is never a public
# hostname. Set only on the Caddy service, which runs the gate before deploying.
# API_PRIVATE_ORIGIN=http://api.railway.internal:4000

# ADR 0022's telemetry destination. A Sentry DSN is a public write-only ingestion
# identifier rather than a credential, so it is configuration and not a secret;
# the operator guide says outright that a published browser DSN is not an
# exposure. Unset, telemetry and alerts stay in the correlated log.
# SENTRY_DSN=https://publickey@o0.ingest.sentry.io/0
# VITE_SENTRY_DSN=https://publickey@o0.ingest.sentry.io/0
# VITE_APP_RELEASE names the build a browser event belongs to, and is set to
# the same released commit as APP_RELEASE where the browser client is built.
# VITE_APP_RELEASE=development

# ADR 0019's shared reviewer identities, as canonical fixture User identifier to
# Auth0 `sub`. Auth0 subjects are public identifiers, not credentials, and this
# map grants nothing: every role stays with the canonical fixture manifest.
# Set only where AUTH_MODE=auth0.
# DEMONSTRATION_IDENTITY_SUBJECTS={"00000000-0000-4000-8000-000000000001":"auth0|example"}

# The two provider origins the browser policy names. Caddy substitutes them
# into the Content Security Policy it writes for every response, and the release
# checks the deployed policy against them. Set only on the Caddy service; an
# unset one narrows the policy rather than widening it.
# AUTH0_TENANT_ORIGIN=https://your-tenant.us.auth0.com
# SENTRY_INGEST_ORIGIN=https://o0.ingest.sentry.io

# The threat model runs the complete policy in report-only mode against the
# private deployment before enforcing the identical policy publicly. Unset
# enforces; the release refuses a public candidate still in report-only mode.
# CSP_HEADER_NAME=Content-Security-Policy-Report-Only

# The deployed smoke journey's own credentials. These live only in the
# protected `production` GitHub environment and never in a service or a file.
# SMOKE_CLIENT_ID=
# SMOKE_CLIENT_SECRET=
# SMOKE_STUDENT_USERNAME=
# SMOKE_STUDENT_PASSWORD=
# SMOKE_TEACHER_USERNAME=
# SMOKE_TEACHER_PASSWORD=
# SMOKE_ORGANIZATION_MANAGER_USERNAME=
# SMOKE_ORGANIZATION_MANAGER_PASSWORD=
# SMOKE_ADMINISTRATOR_USERNAME=
# SMOKE_ADMINISTRATOR_PASSWORD=
