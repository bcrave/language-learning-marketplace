{
  "name": "@marketplace/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "BUILD_TARGET=test node scripts/build.mjs",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:test-api": "tsx src/api/test-main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "release:bind-identities": "node dist/operations/bind-identities-main.js",
    "release:diagnostics": "node dist/operations/owner-diagnostics-main.js",
    "release:gate": "node dist/operations/release-gate-main.js",
    "release:public-surface": "node dist/operations/public-surface-main.js",
    "release:rebuild-fixtures": "node dist/operations/canonical-data-rebuild-main.js",
    "release:recover-fixtures": "node dist/operations/canonical-data-recovery-main.js",
    "release:smoke": "node dist/operations/deployed-smoke-main.js",
    "start:api": "node dist/api/main.js",
    "start:test-api": "node dist/api/test-main.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@graphql-tools/schema": "10.0.38",
    "@js-temporal/polyfill": "0.5.1",
    "@marketplace/core": "workspace:*",
    "@sentry/node": "10.70.0",
    "graphile-worker": "0.17.3",
    "graphql": "16.11.0",
    "graphql-yoga": "5.21.2",
    "intl-messageformat": "11.2.12",
    "jose": "6.2.4",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@marketplace/test-support": "workspace:*",
    "@types/pg": "8.20.0"
  }
}
