{
  "name": "language-learning-marketplace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @marketplace/backend dev:api\" \"pnpm --filter @marketplace/backend dev:worker\" \"pnpm --filter @marketplace/web dev\"",
    "db:migrate": "pnpm --filter @marketplace/backend db:migrate",
    "db:seed": "pnpm --filter @marketplace/backend db:seed",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx scripts/run-browser-matrix.ts",
    "typecheck": "pnpm -r typecheck",
    "verify:public-artifacts": "tsx apps/backend/src/operations/public-artifact-evidence-main.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@eslint/js": "9.39.5",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.9.0",
    "globals": "17.8.0",
    "graphql": "16.11.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
